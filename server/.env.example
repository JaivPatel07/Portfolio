# =============================================
# Email Configuration for Nodemailer
# Copy this file to .env and fill in your values
# =============================================

# Your Gmail address (the one that sends the email)
EMAIL_USER=your_gmail@gmail.com

# Gmail App Password (NOT your normal password)
# How to get it:
#   1. Go to Google Account Settings
#   2. Security → Enable 2-Step Verification
#   3. Security → App Passwords → Generate new (select "Mail")
#   4. Copy the 16-char code here
EMAIL_PASS=your_16_char_app_password

# Where to receive contact form emails (usually same as EMAIL_USER)
EMAIL_TO=your_gmail@gmail.com

# Server port (optional, defaults to 5000)
PORT=5000
